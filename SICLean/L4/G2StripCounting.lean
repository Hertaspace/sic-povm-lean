import SICLean.L4.G2IntegralEvaluation
import SICLean.L4.G2StripCountingAux

set_option autoImplicit false

/-!
# Finite-strip counting over the actual row quotient

Finite-strip counting uses only integer lattices and finite groups.
No analytic identity is assumed. The factor c is stated on [RW26, p. 12, p. 13]. The count is for a
general finite quotient.

The subgroup H is generated by (c,d-1) and (0,N). The finite labels
parametrize Z²/H, not the possibly noncyclic SpecialValueGroup. Each
fiber of Z²/H → SpecialValueGroup has c elements. The deterministic
representatives below have -cN ≤ S < 0. For 0 < δ < scale this is exactly
the open strip -c*length-δ < X < -δ, with both endpoints avoided.

Only the comb labels are counted here. No full straight-contour integral
is identified with a comb sum, and S mod N is never used as a converse
zero-class criterion.
-/

noncomputable section

open Classical Complex Set
open scoped BigOperators MatrixGroups

namespace SICLean.L4.G2.StripCounting

/-- H = Z(c,d-1) + Z(0,N), without choosing a cyclic coordinate on G. -/
def H (M : SL(2, ℤ)) : AddSubgroup (ℤ × ℤ) :=
  AddSubgroup.zmultiples (M 1 0, M 1 1 - 1) ⊔
    AddSubgroup.zmultiples (0, specialValueOrder M)

abbrev HQuotient (M : SL(2, ℤ)) := (ℤ × ℤ) ⧸ H M

def hMk (M : SL(2, ℤ)) : (ℤ × ℤ) →+ HQuotient M :=
  QuotientAddGroup.mk' (H M)

/--
The explicit row identity establishing the vertical period in Λ; [RW26, p. 12].
-/
theorem vertical_period_mem (M : SL(2, ℤ)) :
    L2r.rowAction ((M : Matrix (Fin 2) (Fin 2) ℤ) - 1)
        (M 1 0, -(M 0 0 - 1)) = (0, specialValueOrder M) ∧
      (0, specialValueOrder M) ∈ specialValueLattice M := by
  have hrow : L2r.rowAction ((M : Matrix (Fin 2) (Fin 2) ℤ) - 1)
      (M 1 0, -(M 0 0 - 1)) = (0, specialValueOrder M) := by
    ext <;> simp [L2r.rowAction, Matrix.sub_apply, specialValueOrder]
    · ring
    · linear_combination -det_coe_int M
  exact ⟨hrow, ⟨_, hrow⟩⟩

/--
Both generators, including the second row (c,d-1), lie in Λ; [RW26, p. 12]. No positivity is needed
here.
-/
theorem H_le_lattice (M : SL(2, ℤ)) : H M ≤ specialValueLattice M := by
  apply sup_le
  · apply AddSubgroup.zmultiples_le.mpr
    change ∃ x, L2r.rowAction ((M : Matrix (Fin 2) (Fin 2) ℤ) - 1) x = _
    exact ⟨(0, 1), by simp [L2r.rowAction, Matrix.sub_apply]⟩
  · exact AddSubgroup.zmultiples_le.mpr (vertical_period_mem M).2

/-- The natural map Z²/H → Z²/Λ induced by the identity on rows. -/
def projection (M : SL(2, ℤ)) : HQuotient M →+ SpecialValueGroup M :=
  QuotientAddGroup.map (H M) (specialValueLattice M)
    (AddMonoidHom.id (ℤ × ℤ)) (H_le_lattice M)

/-- The two finite labels are a rectangular transversal for H, not G. -/
abbrev StripLabel (M : SL(2, ℤ)) :=
  Fin (M 1 0).toNat × Fin (specialValueOrder M).toNat

/-- Integer division is Euclidean for c>0. If (1-d)m=cq+r with
0≤r<c, this choice starts at S=-cN+r. -/
def firstK (M : SL(2, ℤ)) (m : ℤ) : ℤ :=
  -specialValueOrder M - ((1 - M 1 1) * m) / M 1 0

/-- Exactly N consecutive k values for each 0≤m<c. -/
def canonicalRepresentative (M : SL(2, ℤ)) (i : StripLabel M) : ℤ × ℤ :=
  ((i.1 : ℤ), firstK M (i.1 : ℤ) + (i.2 : ℤ))

def canonicalQuotient (M : SL(2, ℤ)) (i : StripLabel M) : HQuotient M :=
  hMk M (canonicalRepresentative M i)

def stripClass (M : SL(2, ℤ)) (i : StripLabel M) : SpecialValueGroup M :=
  specialValueMk M (canonicalRepresentative M i)

/-- The actual finite set of labelled integer pairs in the straight strip. -/
def stripFinset (M : SL(2, ℤ)) : Finset (ℤ × ℤ) :=
  Finset.univ.image (canonicalRepresentative M)

/--
Finiteness is recorded separately from the numerical subgroup index; [RW26, p. 12] general finite
quotient.
-/
theorem H_index (M : SL(2, ℤ)) (hM : SpecialValueAdmissible M) :
    Finite (HQuotient M) ∧
      (H M).index = (M 1 0).toNat * (specialValueOrder M).toNat := by
  exact ⟨G2StripCountingAux.triangularQuotient_finite
      (M 1 0) (M 1 1 - 1) (specialValueOrder M) hM.1 (specialValueOrder_pos M hM),
    G2StripCountingAux.triangularLattice_index
      (M 1 0) (M 1 1 - 1) (specialValueOrder M) hM.1 (specialValueOrder_pos M hM)⟩

/--
The already constructed true quotient has index N, regardless of
whether it is cyclic; [RW26, p. 12].
-/
theorem lattice_index (M : SL(2, ℤ)) (hM : SpecialValueAdmissible M) :
    (specialValueLattice M).index = (specialValueOrder M).toNat := by
  exact specialValueGroup_card M hM

/--
Keeping (m,k) as a pair loses no multiplicity; [RW26, p. 12].
-/
theorem canonicalRepresentative_injective (M : SL(2, ℤ)) :
    Function.Injective (canonicalRepresentative M) := by
  rintro ⟨m, k⟩ ⟨m', k'⟩ h
  have hm : m = m' := by
    apply Fin.ext
    have he := congrArg Prod.fst h
    dsimp [canonicalRepresentative] at he
    exact_mod_cast he
  subst m'
  have hk : k = k' := by
    apply Fin.ext
    have he := congrArg Prod.snd h
    dsimp [canonicalRepresentative] at he
    exact_mod_cast (add_left_cancel he)
  subst k'
  rfl

/--
A genuine transversal for Z²/H; it does not identify G with Z/N; [RW26, p. 12].
-/
theorem canonicalQuotient_bijective (M : SL(2, ℤ))
    (hM : SpecialValueAdmissible M) :
    Function.Bijective (canonicalQuotient M) := by
  exact G2StripCountingAux.transversal_bijective
    (M 1 0) (M 1 1 - 1) (specialValueOrder M) hM.1
    (specialValueOrder_pos M hM) (firstK M)

/-- Canonical finite representatives, as an equivalence of types only. -/
def canonicalQuotientEquiv (M : SL(2, ℤ)) (hM : SpecialValueAdmissible M) :
    StripLabel M ≃ HQuotient M :=
  Equiv.ofBijective (canonicalQuotient M) (canonicalQuotient_bijective M hM)

/--
The projection preserves the original row representative literally; [RW26, p. 12].
-/
theorem projection_mk (M : SL(2, ℤ)) (x : ℤ × ℤ) :
    projection M (hMk M x) = specialValueMk M x := by
  rfl

/--
Every fiber over the true group has c elements, without cyclicity; [RW26, p. 12].
-/
theorem projection_fiber_card (M : SL(2, ℤ)) (hM : SpecialValueAdmissible M)
    (x : SpecialValueGroup M) :
    Nat.card {y : HQuotient M // projection M y = x} = (M 1 0).toNat := by
  have hsurj : Function.Surjective (projection M) := by
    intro y
    obtain ⟨z, rfl⟩ := QuotientAddGroup.mk'_surjective (specialValueLattice M) y
    exact ⟨hMk M z, projection_mk M z⟩
  have hkerIndex : (projection M).ker.index = (specialValueOrder M).toNat := by
    rw [AddSubgroup.index_ker, AddMonoidHom.range_eq_top.mpr hsurj,
      AddSubgroup.card_top]
    exact specialValueGroup_card M hM
  have hcard : Nat.card (projection M).ker * (specialValueOrder M).toNat =
      (M 1 0).toNat * (specialValueOrder M).toNat := by
    calc
      _ = Nat.card (HQuotient M) := by
        rw [← hkerIndex]
        exact (projection M).ker.card_mul_index
      _ = _ := (H_index M hM).2
  have hN : (specialValueOrder M).toNat ≠ 0 := by
    have := specialValueOrder_pos M hM
    omega
  calc
    Nat.card {y : HQuotient M // projection M y = x} =
        Nat.card (projection M).ker :=
      Nat.card_congr (AddMonoidHom.fiberEquivKerOfSurjective hsurj x)
    _ = _ := Nat.eq_of_mul_eq_mul_right (Nat.pos_of_ne_zero hN) hcard

/--
For j=0...,N-1 the exact integer values are S=r-cN+cj,
0≤r<c. In particular S=0 is not included; [RW26, p. 12] (the finite count).
-/
theorem canonicalRepresentative_sIndex_bounds (M : SL(2, ℤ))
    (hM : SpecialValueAdmissible M) (i : StripLabel M) :
    -(M 1 0 * specialValueOrder M) ≤ sIndex M (canonicalRepresentative M i) ∧
      sIndex M (canonicalRepresentative M i) < 0 := by
  have hc := hM.1
  have hN := specialValueOrder_pos M hM
  have hj0 : (0 : ℤ) ≤ (i.2 : ℤ) := Int.natCast_nonneg _
  have hjN : (i.2 : ℤ) < specialValueOrder M := by
    have := i.2.isLt
    omega
  have hr0 := Int.emod_nonneg ((1 - M 1 1) * (i.1 : ℤ)) (ne_of_gt hc)
  have hrc := Int.emod_lt_of_pos ((1 - M 1 1) * (i.1 : ℤ)) hc
  have hs : sIndex M (canonicalRepresentative M i) =
      ((1 - M 1 1) * (i.1 : ℤ)) % M 1 0 - M 1 0 * specialValueOrder M +
        M 1 0 * (i.2 : ℤ) := by
    dsimp [sIndex, canonicalRepresentative, firstK]
    rw [Int.emod_def]
    ring
  rw [hs]
  constructor
  · nlinarith [mul_nonneg hc.le hj0]
  · have hj : (i.2 : ℤ) ≤ specialValueOrder M - 1 := by omega
    nlinarith [mul_le_mul_of_nonneg_left hj hc.le]

/--
Exact membership in the open strip, including its component range.
The same deterministic finset works for every 0<δ<scale; [RW26, p. 12].
-/
theorem mem_stripFinset_iff (M : SL(2, ℤ)) (hM : SpecialValueAdmissible M)
    (δ : ℝ) (hδ : 0 < δ) (hδscale : δ < scale M) (x : ℤ × ℤ) :
    x ∈ stripFinset M ↔
      0 ≤ x.1 ∧ x.1 < M 1 0 ∧
        -(M 1 0 : ℝ) * length M - δ < combCoordinate M x.1 x.2 ∧
          combCoordinate M x.1 x.2 < -δ := by
  have hc := hM.1
  have hN := specialValueOrder_pos M hM
  have hs := (scale_identities M hM).1
  have hcoord : combCoordinate M x.1 x.2 = scale M * (sIndex M x : ℝ) := rfl
  have hperiod : scale M * ((-(M 1 0 * specialValueOrder M) : ℤ) : ℝ) =
      -(M 1 0 : ℝ) * length M := by
    rw [G2ContourChainAux.length_eq_scale_mul M hM]
    push_cast
    ring
  have hscaled : (-(M 1 0 * specialValueOrder M) ≤ sIndex M x ∧ sIndex M x < 0) ↔
      -(M 1 0 : ℝ) * length M - δ < combCoordinate M x.1 x.2 ∧
        combCoordinate M x.1 x.2 < -δ := by
    rw [hcoord]
    constructor
    · rintro ⟨hlo, hhi⟩
      have hloR : ((-(M 1 0 * specialValueOrder M) : ℤ) : ℝ) ≤ (sIndex M x : ℝ) := by
        exact_mod_cast hlo
      have hhiR : (sIndex M x : ℝ) ≤ -1 := by
        exact_mod_cast (show sIndex M x ≤ -1 by omega)
      constructor
      · have := mul_le_mul_of_nonneg_left hloR hs.le
        linarith
      · have := mul_le_mul_of_nonneg_left hhiR hs.le
        linarith
    · rintro ⟨hlo, hhi⟩
      constructor
      · by_contra hn
        have hnR : (sIndex M x : ℝ) ≤
            ((-(M 1 0 * specialValueOrder M) : ℤ) : ℝ) - 1 := by
          exact_mod_cast (show sIndex M x ≤ -(M 1 0 * specialValueOrder M) - 1 by omega)
        have := mul_le_mul_of_nonneg_left hnR hs.le
        nlinarith
      · by_contra hn
        have hnR : (0 : ℝ) ≤ (sIndex M x : ℝ) := by
          exact_mod_cast (show 0 ≤ sIndex M x by omega)
        have := mul_nonneg hs.le hnR
        linarith
  rw [← hscaled]
  constructor
  · intro hx
    obtain ⟨i, _, rfl⟩ := Finset.mem_image.mp hx
    have hm0 : (0 : ℤ) ≤ (i.1 : ℤ) := Int.natCast_nonneg _
    have hmc : (i.1 : ℤ) < M 1 0 := by
      have := i.1.isLt
      omega
    exact ⟨hm0, hmc, canonicalRepresentative_sIndex_bounds M hM i⟩
  · rintro ⟨hm0, hmc, hlo, hhi⟩
    let j := x.2 - firstK M x.1
    have hr0 := Int.emod_nonneg ((1 - M 1 1) * x.1) (ne_of_gt hc)
    have hrc := Int.emod_lt_of_pos ((1 - M 1 1) * x.1) hc
    have hindex : sIndex M x = ((1 - M 1 1) * x.1) % M 1 0 -
        M 1 0 * specialValueOrder M + M 1 0 * j := by
      dsimp [sIndex, j, firstK]
      rw [Int.emod_def]
      ring
    have hj0 : 0 ≤ j := by
      by_contra hn
      have hj : j ≤ -1 := by omega
      have := mul_le_mul_of_nonneg_left hj hc.le
      nlinarith
    have hjN : j < specialValueOrder M := by
      by_contra hn
      have hj : specialValueOrder M ≤ j := by omega
      have := mul_le_mul_of_nonneg_left hj hc.le
      nlinarith
    let i : StripLabel M := (⟨x.1.toNat, by omega⟩, ⟨j.toNat, by omega⟩)
    apply Finset.mem_image.mpr
    refine ⟨i, Finset.mem_univ _, ?_⟩
    ext
    · exact Int.toNat_of_nonneg hm0
    · change firstK M (x.1.toNat : ℤ) + (j.toNat : ℤ) = x.2
      rw [Int.toNat_of_nonneg hm0, Int.toNat_of_nonneg hj0]
      dsimp [j]
      omega

/--
No pair multiplicities collapse in the image finset; [RW26, p. 12].
-/
theorem stripFinset_card (M : SL(2, ℤ)) :
    (stripFinset M).card = (M 1 0).toNat * (specialValueOrder M).toNat := by
  rw [stripFinset, Finset.card_image_of_injective _ (canonicalRepresentative_injective M)]
  simp only [Finset.card_univ, Fintype.card_prod, Fintype.card_fin]

/--
Both the finite-label and concrete-pair forms of the c-fold count.
The filter tests equality in the actual quotient G; [RW26, p. 12].
-/
theorem strip_fiber_card (M : SL(2, ℤ)) (hM : SpecialValueAdmissible M)
    (x : SpecialValueGroup M) :
    ((Finset.univ : Finset (StripLabel M)).filter
        (fun i => stripClass M i = x)).card = (M 1 0).toNat ∧
      ((stripFinset M).filter
        (fun y => specialValueMk M y = x)).card = (M 1 0).toNat := by
  have hlabel : ((Finset.univ : Finset (StripLabel M)).filter
      (fun i => stripClass M i = x)).card = (M 1 0).toNat := by
    calc
      _ = Nat.card {i : StripLabel M // stripClass M i = x} := by
        rw [Nat.card_eq_fintype_card, Fintype.card_subtype]
      _ = Nat.card {y : HQuotient M // projection M y = x} := by
        apply Nat.card_congr
        exact (canonicalQuotientEquiv M hM).subtypeEquiv (fun _ => Iff.rfl)
      _ = _ := projection_fiber_card M hM x
  refine ⟨hlabel, ?_⟩
  rw [stripFinset, Finset.filter_image,
    Finset.card_image_of_injective _ (canonicalRepresentative_injective M)]
  exact hlabel

/--
The period shift is k↦k-N, preserving the H-class and true G-class
while moving the common coordinate by -cL; [RW26, p. 13].
-/
theorem subtract_vertical_period (M : SL(2, ℤ)) (hM : SpecialValueAdmissible M)
    (m k : ℤ) :
    hMk M (m, k - specialValueOrder M) = hMk M (m, k) ∧
      specialValueMk M (m, k - specialValueOrder M) = specialValueMk M (m, k) ∧
        combCoordinate M m (k - specialValueOrder M) =
          combCoordinate M m k - (M 1 0 : ℝ) * length M := by
  have hperiodH : (0, specialValueOrder M) ∈ H M := by
    have hle : AddSubgroup.zmultiples (0, specialValueOrder M) ≤ H M := le_sup_right
    exact hle (AddSubgroup.mem_zmultiples _)
  have hH : hMk M (0, specialValueOrder M) = 0 :=
    (QuotientAddGroup.eq_zero_iff _).mpr hperiodH
  have hG : specialValueMk M (0, specialValueOrder M) = 0 :=
    (QuotientAddGroup.eq_zero_iff _).mpr (vertical_period_mem M).2
  have hp : (m, k - specialValueOrder M) = (m, k) - (0, specialValueOrder M) := by
    ext <;> simp
  refine ⟨?_, ?_, ?_⟩
  · rw [hp, map_sub, hH, sub_zero]
  · rw [hp, map_sub, hG, sub_zero]
  · rw [combCoordinate, combCoordinate, G2ContourChainAux.length_eq_scale_mul M hM]
    push_cast
    ring

/-- A concrete local enumeration of the already proved finite group. -/
abbrev specialGroupFintype (M : SL(2, ℤ)) (hM : SpecialValueAdmissible M) :
    Fintype (SpecialValueGroup M) :=
  letI : Finite (SpecialValueGroup M) := specialValueGroup_finite M hM
  Fintype.ofFinite _

/-- The ordinary sum over the true finite group, with its finiteness
supplied by admissibility rather than requested as an extra input. -/
def groupSum (M : SL(2, ℤ)) (hM : SpecialValueAdmissible M)
    (f : SpecialValueGroup M → ℂ) : ℂ :=
  letI : Fintype (SpecialValueGroup M) := specialGroupFintype M hM
  ∑ x : SpecialValueGroup M, f x

/--
Arbitrary class functions, hence both later weighted residue sums.
The sum on the right is over the true group, not over S mod N; [RW26, p. 12, p. 13].
-/
theorem strip_sum (M : SL(2, ℤ)) (hM : SpecialValueAdmissible M)
    (f : SpecialValueGroup M → ℂ) :
    (∑ y ∈ stripFinset M, f (specialValueMk M y)) =
      (M 1 0 : ℂ) * groupSum M hM f := by
  let : Fintype (SpecialValueGroup M) := specialGroupFintype M hM
  rw [stripFinset, Finset.sum_image (fun _ _ _ _ h => canonicalRepresentative_injective M h)]
  change (∑ i : StripLabel M, f (stripClass M i)) = _
  have hc : ((M 1 0).toNat : ℂ) = (M 1 0 : ℂ) := by
    exact_mod_cast Int.toNat_of_nonneg hM.1.le
  calc
    _ = ∑ x : SpecialValueGroup M,
        ∑ i ∈ (Finset.univ : Finset (StripLabel M)).filter
          (fun i => stripClass M i = x), f x :=
      (Finset.sum_fiberwise' Finset.univ (stripClass M) f).symm
    _ = ∑ x : SpecialValueGroup M, (M 1 0 : ℂ) * f x := by
      apply Finset.sum_congr rfl
      intro x _
      rw [Finset.sum_const, (strip_fiber_card M hM x).1, nsmul_eq_mul, hc]
    _ = _ := by rw [← Finset.mul_sum]; rfl

/--
Each numerator-zero and denominator-zero class occurs exactly c
times. No assumption v≠0 is needed just for these two counts; [RW26, p. 13] zero classes. These are
full quotient equalities, not tests on S mod N.
-/
theorem zero_class_counts (M : SL(2, ℤ)) (hM : SpecialValueAdmissible M)
    (v : SpecialValueGroup M) :
    ((stripFinset M).filter
        (fun x => specialValueMk M x = 0)).card = (M 1 0).toNat ∧
      ((stripFinset M).filter
        (fun x => specialValueMk M x + v = 0)).card = (M 1 0).toNat := by
  refine ⟨(strip_fiber_card M hM 0).2, ?_⟩
  simpa only [add_eq_zero_iff_eq_neg] using (strip_fiber_card M hM (-v)).2

#print H
#print firstK
#print groupSum
#check projection_fiber_card
#check mem_stripFinset_iff
#check strip_sum
#check zero_class_counts

end SICLean.L4.G2.StripCounting
