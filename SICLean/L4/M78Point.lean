import SICLean.L4.M75Family
import SICLean.L4.PseudolatticeDownstream

set_option autoImplicit false

/-!
# The same analytic point of the same finite system

The actual IsSolution constructor is exactly
⟨M74.system_q1 F, M74.system_q2 F, M75.Family.system_q3 F h7, M74.system_q4 F⟩.
For algebraicity, install M74.coefficientField_isAlgebraic F as a local
instance, then call (M74.system F).solution_isAlgebraic on that actual point.
The field was defined earlier using only sqrtN, Gaussian and kappa. It is
never generated by E, and no valuation of a transcendental E is assumed.
F-minus at zero is the inverse of the already algebraic positive sqrt(epsilon).
M74.familyMinusPoint and M72.familyMinusPoint are definitionally equal;
no duplicate compatibility statement is needed.
[RW26, p. 3, p. 23, (4), Theorem 1, Corollary 4, Theorem 11, footnote 2]. Algebraicity of the
abstract point is proved in `L3.Algebraicity`.
-/

noncomputable section

namespace SICLean.L3.M78.Point

universe u

variable {K : Type u} [Field K] [NumberField K] {P : PeriodData K}

/--
An arithmetic zero-value lemma: use the existing normalization
polynomial, without (7) or algebraicity of E; [RW26, p. 3, (4)].
-/
theorem period_sqrt_isAlgebraic (P : PeriodData K) :
    IsAlgebraic ℚ (Real.sqrt (P.sigma₁ P.epsilon) : ℂ) := by
  refine ⟨Polynomial.X ^ 4 - Polynomial.C ((P.N : ℚ) + 2) * Polynomial.X ^ 2 + 1,
    ?_, ?_⟩
  · intro h
    have hc := congrArg (fun p : Polynomial ℚ => p.coeff 4) h
    simp only [Polynomial.coeff_add, Polynomial.coeff_sub, Polynomial.coeff_C_mul,
      Polynomial.coeff_X_pow, Polynomial.coeff_one, Polynomial.coeff_zero] at hc
    norm_num at hc
  · have hs : (Real.sqrt (P.sigma₁ P.epsilon) : ℂ) ^ 2 =
        (P.sigma₁ P.epsilon : ℂ) := by
      exact_mod_cast Real.sq_sqrt
        (le_of_lt (lt_trans zero_lt_one P.epsilon_gt_one))
    have hp : (P.sigma₁ P.epsilon : ℂ) ^ 2 -
        ((P.N : ℂ) + 2) * (P.sigma₁ P.epsilon : ℂ) + 1 = 0 := by
      exact_mod_cast M74.period_polynomial P
    simpa only [map_add, map_sub, map_mul, map_pow, map_one,
      Polynomial.aeval_X, Polynomial.aeval_C, map_natCast, map_ofNat,
      show (4 : ℕ) = 2 * 2 from rfl, pow_mul, hs] using hp

/--
The prescribed minus zero branch is algebraic independently of (7); [RW26, p. 3, (4), footnote 2].
-/
theorem period_sqrt_inv_isAlgebraic (P : PeriodData K) :
    IsAlgebraic ℚ ((Real.sqrt (P.sigma₁ P.epsilon) : ℂ)⁻¹) := by
  exact (period_sqrt_isAlgebraic P).inv

/--
Whole-family actual complex point, with no free Q3 or hAlg input.
All four fields have the precise types of FiniteSystem.IsSolution; [RW26, p. 23, Theorem 11].
-/
theorem familyPoint_isSolution (F : FinitePseudolatticeFamily P)
    (h7 : M75.Family.FamilyPentagon F) :
    (M74.system F).IsSolution ℂ (pseudolatticeFamilyPoint F) := by
  exact ⟨M74.system_q1 F, M74.system_q2 F, M75.Family.system_q3 F h7,
    M74.system_q4 F⟩

/--
Membership in the zero locus of exactly the already defined ideal.
 [RW26, p. 23, Theorem 11].
This is the actual point, not existence of some algebraic point.
-/
theorem familyPoint_mem_zeroLocus (F : FinitePseudolatticeFamily P)
    (h7 : M75.Family.FamilyPentagon F) :
    pseudolatticeFamilyPoint F ∈
      MvPolynomial.zeroLocus ℂ (M74.system F).equationIdeal := by
  exact ((M74.system F).isSolution_iff_mem_zeroLocus ℂ
    (pseudolatticeFamilyPoint F)).mp (familyPoint_isSolution F h7)

/--
Algebraicity of the family point, from `FiniteSystem.solution_isAlgebraic` with the local
coefficient-field algebraicity instance and `familyPoint_isSolution`; [RW26, p. 3, Theorem 1].
-/
theorem familyPoint_isAlgebraic (F : FinitePseudolatticeFamily P)
    (h7 : M75.Family.FamilyPentagon F)
    (c : Coordinate (Fin F.size) (PseudolatticeFamilyGroup F)) :
    IsAlgebraic ℚ (pseudolatticeFamilyPoint F c) := by
  let : Algebra.IsAlgebraic ℚ (M74.coefficientField F) :=
    M74.coefficientField_isAlgebraic F
  exact (M74.system F).solution_isAlgebraic (pseudolatticeFamilyPoint F)
    (familyPoint_isSolution F h7) c

/--
The same coordinates also satisfy a polynomial over the same coefficient
field. This follows after rational algebraicity and does not define the field; [RW26, p. 23,
Corollary 4].
-/
theorem familyPoint_isAlgebraic_over_coefficients (F : FinitePseudolatticeFamily P)
    (h7 : M75.Family.FamilyPentagon F)
    (c : Coordinate (Fin F.size) (PseudolatticeFamilyGroup F)) :
    IsAlgebraic (M74.coefficientField F) (pseudolatticeFamilyPoint F c) := by
  exact (familyPoint_isAlgebraic F h7 c).extendScalars
    (algebraMap ℚ (M74.coefficientField F)).injective

/--
Only the zero branch takes an inverse; all other coordinates are E; [RW26, p. 3, (4), footnote 2].
-/
theorem familyMinusPoint_isAlgebraic (F : FinitePseudolatticeFamily P)
    (h7 : M75.Family.FamilyPentagon F)
    (c : Coordinate (Fin F.size) (PseudolatticeFamilyGroup F)) :
    IsAlgebraic ℚ (M74.familyMinusPoint F c) := by
  classical
  by_cases hc : c.2 = 0
  · simpa only [M74.familyMinusPoint, if_pos hc] using period_sqrt_inv_isAlgebraic P
  · simpa only [M74.familyMinusPoint, if_neg hc] using familyPoint_isAlgebraic F h7 c

/--
Both actual branches, for each coordinate of the finite family; [RW26, p. 3, Theorem 1, footnote 2].
-/
theorem familyValues_isAlgebraic (F : FinitePseudolatticeFamily P)
    (h7 : M75.Family.FamilyPentagon F)
    (c : Coordinate (Fin F.size) (PseudolatticeFamilyGroup F)) :
    IsAlgebraic ℚ (pseudolatticeFamilyPoint F c) ∧
      IsAlgebraic ℚ (M74.familyMinusPoint F c) := by
  exact ⟨familyPoint_isAlgebraic F h7 c, familyMinusPoint_isAlgebraic F h7 c⟩

/--
The finite family may be chosen from PeriodData, rather than
supplied as a finiteness assumption. Only its explicit (7) remains an input.
 [RW26, p. 23, Theorem 11].
-/
theorem chosenFamilyPoint_isSolution (P : PeriodData K)
    (h7 : M75.Family.FamilyPentagon (chosenPseudolatticeFamily P)) :
    (M74.system (chosenPseudolatticeFamily P)).IsSolution ℂ
      (pseudolatticeFamilyPoint (chosenPseudolatticeFamily P)) := by
  exact familyPoint_isSolution (chosenPseudolatticeFamily P) h7

/--
Chosen-family output of the proven abstract core, with no hAlg premise; [RW26, p. 3, Theorem 1].
-/
theorem chosenFamilyPoint_isAlgebraic (P : PeriodData K)
    (h7 : M75.Family.FamilyPentagon (chosenPseudolatticeFamily P))
    (c : Coordinate (Fin (chosenPseudolatticeFamily P).size)
      (PseudolatticeFamilyGroup (chosenPseudolatticeFamily P))) :
    IsAlgebraic ℚ (pseudolatticeFamilyPoint (chosenPseudolatticeFamily P) c) := by
  exact familyPoint_isAlgebraic (chosenPseudolatticeFamily P) h7 c

#check @M74.system_q1
#check @M74.system_q2
#check @M74.system_q4
#check @M75.Family.system_q3
#print M74.coefficientField
#check @M74.coefficientField_isAlgebraic
#check @FiniteSystem.solution_isAlgebraic
#check @familyPoint_isSolution
#check @familyPoint_isAlgebraic

end SICLean.L3.M78.Point
