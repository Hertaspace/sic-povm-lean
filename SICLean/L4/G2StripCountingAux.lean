import SICLean.L4.G2IntegralEvaluation

set_option autoImplicit false

/-!
A rectangular transversal for an arbitrary triangular subgroup of `ℤ × ℤ`.
The lower endpoint in each vertical column is arbitrary.
-/

namespace SICLean.L4.G2StripCountingAux

/-- The subgroup generated by the two rows of an integer triangular matrix. -/
def triangularLattice (c d N : ℤ) : AddSubgroup (ℤ × ℤ) :=
  AddSubgroup.zmultiples (c, d) ⊔ AddSubgroup.zmultiples (0, N)

/-- Rectangular labels with an arbitrary integral vertical offset in each column. -/
def transversalRepresentative (c N : ℤ) (f : ℤ → ℤ)
    (i : Fin c.toNat × Fin N.toNat) : ℤ × ℤ :=
  ((i.1 : ℤ), f (i.1 : ℤ) + (i.2 : ℤ))

/-- The rectangular labels map to the actual quotient by the triangular lattice. -/
def transversal (c d N : ℤ) (f : ℤ → ℤ)
    (i : Fin c.toNat × Fin N.toNat) : (ℤ × ℤ) ⧸ triangularLattice c d N :=
  QuotientAddGroup.mk' (triangularLattice c d N) (transversalRepresentative c N f i)

/-- Membership is exactly an integer linear combination of the two rows. -/
theorem mem_triangularLattice_iff (c d N : ℤ) (x : ℤ × ℤ) :
    x ∈ triangularLattice c d N ↔
      ∃ a b : ℤ, x.1 = a * c ∧ x.2 = a * d + b * N := by
  rw [triangularLattice, AddSubgroup.mem_sup]
  constructor
  · rintro ⟨y, hy, z, hz, hsum⟩
    obtain ⟨a, rfl⟩ := AddSubgroup.mem_zmultiples_iff.mp hy
    obtain ⟨b, rfl⟩ := AddSubgroup.mem_zmultiples_iff.mp hz
    refine ⟨a, b, ?_⟩
    simpa using (Prod.ext_iff.mp hsum.symm)
  · rintro ⟨a, b, hx, hy⟩
    refine ⟨a • (c, d), AddSubgroup.mem_zmultiples_iff.mpr ⟨a, rfl⟩,
      b • (0, N), AddSubgroup.mem_zmultiples_iff.mpr ⟨b, rfl⟩, ?_⟩
    apply Prod.ext
    · simpa using hx.symm
    · simpa using hy.symm

private theorem eq_of_sub_multiple {p x y a : ℤ} (_hp : 0 < p)
    (hx0 : 0 ≤ x) (hxp : x < p) (hy0 : 0 ≤ y) (hyp : y < p)
    (hxy : x - y = a * p) : x = y := by
  have hmod : x % p = y % p :=
    Int.emod_eq_emod_iff_emod_sub_eq_zero.mpr (by rw [hxy]; simp)
  simpa only [Int.emod_eq_of_lt hx0 hxp, Int.emod_eq_of_lt hy0 hyp] using hmod

/-- Every choice of one block of `N` consecutive integers per column is a transversal. -/
theorem transversal_bijective (c d N : ℤ) (hc : 0 < c) (hN : 0 < N)
    (f : ℤ → ℤ) : Function.Bijective (transversal c d N f) := by
  constructor
  · intro i j hij
    have hmem : transversalRepresentative c N f i - transversalRepresentative c N f j ∈
        triangularLattice c d N := QuotientAddGroup.eq_iff_sub_mem.mp hij
    obtain ⟨a, b, hx, hy⟩ := (mem_triangularLattice_iff c d N _).mp hmem
    change (i.1 : ℤ) - (j.1 : ℤ) = a * c at hx
    change (f (i.1 : ℤ) + (i.2 : ℤ)) - (f (j.1 : ℤ) + (j.2 : ℤ)) =
      a * d + b * N at hy
    have hi1 := i.1.isLt
    have hj1 := j.1.isLt
    have hi2 := i.2.isLt
    have hj2 := j.2.isLt
    have hfirst : (i.1 : ℤ) = (j.1 : ℤ) :=
      eq_of_sub_multiple hc (by omega) (by omega) (by omega) (by omega) hx
    have ha : a = 0 := (mul_eq_zero.mp (show a * c = 0 by omega)).resolve_right hc.ne'
    rw [ha, zero_mul, zero_add, hfirst] at hy
    have hsecond : (i.2 : ℤ) = (j.2 : ℤ) :=
      eq_of_sub_multiple (a := b) hN (by omega) (by omega) (by omega) (by omega) (by omega)
    apply Prod.ext
    · apply Fin.ext
      exact_mod_cast hfirst
    · apply Fin.ext
      exact_mod_cast hsecond
  · intro q
    obtain ⟨x, rfl⟩ := QuotientAddGroup.mk'_surjective (triangularLattice c d N) q
    let r : ℤ := x.1 % c
    let t : ℤ := x.2 - (x.1 / c) * d - f r
    let s : ℤ := t % N
    have hr0 : 0 ≤ r := Int.emod_nonneg _ hc.ne'
    have hrc : r < c := Int.emod_lt_of_pos _ hc
    have hs0 : 0 ≤ s := Int.emod_nonneg _ hN.ne'
    have hsN : s < N := Int.emod_lt_of_pos _ hN
    let i : Fin c.toNat × Fin N.toNat :=
      (⟨r.toNat, by omega⟩, ⟨s.toNat, by omega⟩)
    have hi1 : (i.1 : ℤ) = r := Int.toNat_of_nonneg hr0
    have hi2 : (i.2 : ℤ) = s := Int.toNat_of_nonneg hs0
    refine ⟨i, ?_⟩
    apply Eq.symm
    apply QuotientAddGroup.eq_iff_sub_mem.mpr
    apply (mem_triangularLattice_iff c d N _).mpr
    refine ⟨x.1 / c, t / N, ?_, ?_⟩
    · change x.1 - (i.1 : ℤ) = x.1 / c * c
      rw [hi1]
      have hx := Int.emod_add_mul_ediv x.1 c
      dsimp [r]
      nlinarith [hx]
    · change x.2 - (f (i.1 : ℤ) + (i.2 : ℤ)) = x.1 / c * d + t / N * N
      rw [hi1, hi2]
      have ht := Int.emod_add_mul_ediv t N
      dsimp [s]
      dsimp [t] at ht ⊢
      nlinarith [ht]

/-- The finite rectangular labels enumerate the triangular quotient. -/
noncomputable def transversalEquiv (c d N : ℤ) (hc : 0 < c) (hN : 0 < N)
    (f : ℤ → ℤ) :
    (Fin c.toNat × Fin N.toNat) ≃ ((ℤ × ℤ) ⧸ triangularLattice c d N) :=
  Equiv.ofBijective (transversal c d N f) (transversal_bijective c d N hc hN f)

/-- The quotient is finite whenever the two diagonal entries are positive. -/
theorem triangularQuotient_finite (c d N : ℤ) (hc : 0 < c) (hN : 0 < N) :
    Finite ((ℤ × ℤ) ⧸ triangularLattice c d N) :=
  Finite.of_surjective (transversal c d N (fun _ => 0))
    (transversal_bijective c d N hc hN (fun _ => 0)).surjective

/-- The index is the product of the positive diagonal entries. -/
theorem triangularLattice_index (c d N : ℤ) (hc : 0 < c) (hN : 0 < N) :
    (triangularLattice c d N).index = c.toNat * N.toNat := by
  rw [AddSubgroup.index_eq_card]
  calc
    Nat.card ((ℤ × ℤ) ⧸ triangularLattice c d N) =
        Nat.card (Fin c.toNat × Fin N.toNat) :=
      (Nat.card_congr (transversalEquiv c d N hc hN (fun _ => 0))).symm
    _ = c.toNat * N.toNat := by simp

end SICLean.L4.G2StripCountingAux
