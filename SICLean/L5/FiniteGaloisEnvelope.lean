import SICLean.Galois.AlgebraicClosure

set_option autoImplicit false

/-!
# The finite normal envelope inside the fixed algebraic closure

[RW-rec, Prop. 4, p. 14]. The envelope is the normal closure of `H`
together with the given values. Algebraicity of the values is [RW26, Thm. 1, p. 3].

Mathlib: `FieldTheory/Normal/Closure.lean`, `FieldTheory/Normal/Defs.lean`,
`Normal/Basic.lean`, `NumberTheory/NumberField/Basic.lean`.
No ray class field, Artin map, or density is defined here.
-/

noncomputable section

open SICLean.Galois

namespace SICLean.L5.FiniteGaloisEnvelope

/-- The field generated by the finite list of algebraic numbers.
Mathlib `IntermediateField.adjoin`. -/
def generatedField (S : Finset Qbar) : IntermediateField ℚ Qbar :=
  IntermediateField.adjoin ℚ (S : Set Qbar)

/-- Normal closure of the compositum.
Mathlib `Normal/Closure.lean`. -/
def envelope (H : IntermediateField ℚ Qbar) (S : Finset Qbar) :
    IntermediateField ℚ Qbar :=
  IntermediateField.normalClosure ℚ
    (H ⊔ generatedField S : IntermediateField ℚ Qbar) Qbar

/-- Finite algebraic adjunction and Mathlib `NumberField.of_module_finite`. -/
theorem generatedField_numberField (S : Finset Qbar) :
    NumberField (generatedField S) := by
  have : FiniteDimensional ℚ (generatedField S) :=
    IntermediateField.finiteDimensional_adjoin fun x _ =>
      Algebra.IsIntegral.isIntegral x
  exact NumberField.of_module_finite ℚ (generatedField S)
attribute [instance] generatedField_numberField

/-- Mathlib `normalClosure.is_finiteDimensional` and finite-dimensional composita.
Only H, rather than ℚbar, is assumed finite. -/
theorem envelope_numberField (H : IntermediateField ℚ Qbar) [NumberField H]
    (S : Finset Qbar) : NumberField (envelope H S) := by
  unfold envelope
  exact NumberField.of_module_finite ℚ _
attribute [instance] envelope_numberField

/-- Mathlib `normalClosure.normal`. H need not already be normal. -/
theorem envelope_normal (H : IntermediateField ℚ Qbar) (S : Finset Qbar) :
    Normal ℚ (envelope H S) := by
  unfold envelope
  infer_instance
attribute [instance] envelope_normal

/-- Mathlib `IsGalois.normalClosure`, with characteristic-zero separability. -/
theorem envelope_isGalois (H : IntermediateField ℚ Qbar) (S : Finset Qbar) :
    IsGalois ℚ (envelope H S) := by
  unfold envelope
  infer_instance
attribute [instance] envelope_isGalois

/-- Mathlib `IntermediateField.le_normalClosure`, composed with the compositum inclusion. -/
theorem le_envelope (H : IntermediateField ℚ Qbar) (S : Finset Qbar) :
    H ≤ envelope H S := by
  exact le_sup_left.trans (IntermediateField.le_normalClosure (H ⊔ generatedField S))

/-- The same inclusion for every original value. -/
theorem subset_envelope (H : IntermediateField ℚ Qbar) (S : Finset Qbar) :
    (S : Set Qbar) ⊆ envelope H S := by
  have h : generatedField S ≤ envelope H S :=
    le_sup_right.trans (IntermediateField.le_normalClosure (H ⊔ generatedField S))
  exact (IntermediateField.subset_adjoin ℚ (S : Set Qbar)).trans h

/-- Mathlib `IntermediateField.normalClosure_def''`: all absolute ℚ-conjugates are used. -/
theorem envelope_eq_iSup (H : IntermediateField ℚ Qbar) (S : Finset Qbar) :
    envelope H S = ⨆ g : QbarAut,
      (H ⊔ generatedField S).map (g : Qbar →ₐ[ℚ] Qbar) := by
  exact IntermediateField.normalClosure_def'' (H ⊔ generatedField S)

/-- Minimality among normal subfields, not among arbitrary subfields.
Mathlib `IntermediateField.normalClosure_le_iff_of_normal`. -/
theorem envelope_le_iff (H T : IntermediateField ℚ Qbar) [Normal ℚ T]
    (S : Finset Qbar) :
    envelope H S ≤ T ↔ H ≤ T ∧ (S : Set Qbar) ⊆ T := by
  rw [envelope, IntermediateField.normalClosure_le_iff_of_normal, sup_le_iff,
    generatedField, IntermediateField.adjoin_le_iff]

/-- Restrict an absolute automorphism to the normal envelope.
Mathlib `Normal/Defs.lean`. -/
def restrictQbarAut (H : IntermediateField ℚ Qbar) (S : Finset Qbar) :
    QbarAut →* (envelope H S ≃ₐ[ℚ] envelope H S) :=
  AlgEquiv.restrictNormalHom (envelope H S)

/-- Mathlib `AlgEquiv.restrictNormalHom_apply`: the embedding is the subtype map. -/
theorem restrictQbarAut_apply (H : IntermediateField ℚ Qbar) (S : Finset Qbar)
    (g : QbarAut) (x : envelope H S) :
    ((restrictQbarAut H S g x : envelope H S) : Qbar) = g (x : Qbar) := by
  exact AlgEquiv.restrictNormalHom_apply (envelope H S) g x

/-- Extension inside this algebraic closure. Mathlib `Normal/Basic.lean`. -/
theorem restrictQbarAut_surjective (H : IntermediateField ℚ Qbar) (S : Finset Qbar) :
    Function.Surjective (restrictQbarAut H S) := by
  exact AlgEquiv.restrictNormalHom_surjective (F := ℚ) (K₁ := envelope H S) (E := Qbar)

/-- Mathlib `AlgEquiv.restrictNormal_eq_one_iff`. This does not assert g=1 on all ℚbar. -/
theorem restrictQbarAut_eq_one_iff (H : IntermediateField ℚ Qbar) (S : Finset Qbar)
    (g : QbarAut) :
    restrictQbarAut H S g = 1 ↔ ∀ x ∈ envelope H S, g x = x := by
  exact AlgEquiv.restrictNormal_eq_one_iff (envelope H S) g

/-- Finiteness of automorphisms of a finite-dimensional extension. -/
theorem finite_aut (H : IntermediateField ℚ Qbar) [NumberField H] (S : Finset Qbar) :
    Finite (envelope H S ≃ₐ[ℚ] envelope H S) := by
  infer_instance

end SICLean.L5.FiniteGaloisEnvelope

#check @IntermediateField.normalClosure
#check @AlgEquiv.restrictNormalHom
#check @SICLean.L5.FiniteGaloisEnvelope.envelope_numberField
#print SICLean.L5.FiniteGaloisEnvelope.envelope
