import SICLean.L5.SplitFrobeniusFinite
import SICLean.L5.ClassFieldInfinite

set_option autoImplicit false

/-!
# The normalized values and their finite normal envelope

The finite range, the normal envelope, and the restrictions are constructed
here. The envelope in [RW-rec, pp. 14--15, Prop. 4] is generated by the class
field and the original lattice values. [RW26, p. 20, (37)] identifies the
values, and their algebraicity is [RW26, p. 3, Thm. 1].

S includes the origin. F is the normal closure of H and S. No definition
assumes S ⊆ H, and no translated lattice value is adjoined. Analytic objects
and square-root branches are those of the actual-value modules.
-/

noncomputable section
open scoped MatrixGroups Classical

namespace SICLean.L5.DescentField

variable (M : SL(2, ℤ)) (hM : L4.SpecialValueAdmissible M)

local notation "K" => ActualField.baseField M hM
local notation "P₀" => ActualField.periodData M hM
local notation "I" => ActualLattice.stableLattice M hM
local notation "U" => SplitPrimeValues.normalizedLift P₀ I

/-- An admissible auxiliary level. [RW-rec, Prop. 4]. -/
def defaultLevel : ℕ := Nat.lcm 4 (2 * AddMonoid.exponent (ActualLattice.Group M hM))

/-- [RW-rec, p. 14]: finiteness of the label group makes its exponent positive,
and the displayed level is divisible by 4 and by twice that exponent. -/
theorem defaultLevel_valid :
    RayArithmeticOrder.ValidLevel M hM (defaultLevel M hM) := by
  refine ⟨?_, Nat.dvd_lcm_left _ _, Nat.dvd_lcm_right _ _⟩
  exact Nat.lcm_pos (by decide)
    (Nat.mul_pos (by decide)
      (Nat.pos_of_ne_zero (AddMonoid.exponent_ne_zero_of_finite)))

/-- The finite range of the normalized lift, including x = 0.
[RW26, (37)]; [RW-rec, Prop. 4]. -/
def normalizedValues : Finset Galois.Qbar :=
  letI := Fintype.ofFinite (ActualLattice.Group M hM)
  Finset.univ.image U

/-- Membership in S does not require a nonzero label. -/
theorem mem_normalizedValues_iff (u : Galois.Qbar) :
    u ∈ normalizedValues M hM ↔ ∃ x : ActualLattice.Group M hM, U x = u := by
  classical
  simp only [normalizedValues, Finset.mem_image, Finset.mem_univ, true_and]

/-- Every normalized value belongs to the finite range. -/
theorem normalized_mem_values (x : ActualLattice.Group M hM) :
    U x ∈ normalizedValues M hM := by
  exact (mem_normalizedValues_iff M hM _).mpr ⟨x, rfl⟩

/-- [RW-rec, p. 3, Def. 1]; [RW-rec, p. 13]: the retained origin is 1. -/
theorem one_mem_normalizedValues : (1 : Galois.Qbar) ∈ normalizedValues M hM := by
  exact (mem_normalizedValues_iff M hM _).mpr
    ⟨0, SplitPrimeValues.normalizedLift_zero P₀ I⟩

/-- Reflection permutes this finite range. This does not assert that an
automorphism acts by reflection. [RW-rec, Prop. 4]. -/
theorem normalizedValues_neg_range :
    (normalizedValues M hM : Set Galois.Qbar) =
      Set.range (fun x : ActualLattice.Group M hM => U (-x)) := by
  ext u
  change u ∈ normalizedValues M hM ↔ ∃ x : ActualLattice.Group M hM, U (-x) = u
  rw [mem_normalizedValues_iff]
  constructor
  · rintro ⟨x, rfl⟩
    exact ⟨-x, by rw [neg_neg]⟩
  · rintro ⟨x, hx⟩
    exact ⟨-x, hx⟩

/-- The finite Galois envelope of H, for the level n = cm.
The definition does not use `U x ∈ H`. [RW-rec, Prop. 4]. -/
def field (m : ℕ) : IntermediateField ℚ Galois.Qbar :=
  FiniteGaloisEnvelope.envelope
    (ClassFieldTransport.qbarField M hM (RayArithmeticModulus.level M hM m))
    (normalizedValues M hM)

/-- `FiniteGaloisEnvelope.envelope_numberField`. -/
theorem field_numberField (m : ℕ) : NumberField (field M hM m) := by
  exact FiniteGaloisEnvelope.envelope_numberField _ _
attribute [instance] field_numberField

/-- `FiniteGaloisEnvelope.envelope_isGalois`. -/
theorem field_isGalois (m : ℕ) : IsGalois ℚ (field M hM m) := by
  exact FiniteGaloisEnvelope.envelope_isGalois _ _
attribute [instance] field_isGalois

/-- Inclusion of the class field into the normal closure. [RW-rec, Prop. 4]. -/
theorem classField_le (m : ℕ) :
    ClassFieldTransport.qbarField M hM (RayArithmeticModulus.level M hM m) ≤
      field M hM m := by
  exact FiniteGaloisEnvelope.le_envelope _ _

/-- The same field K is a subfield of F. [RW26, (37)]; [RW-rec, Prop. 4]. -/
theorem base_le (m : ℕ) : K ≤ field M hM m := by
  exact (ClassFieldTransport.base_le M hM _).trans (classField_le M hM m)

/-- The real quadratic base is Galois over ℚ, by
`ClassFieldIdealAction.base_normal`. [RW26, (37)]. -/
theorem base_isGalois : IsGalois ℚ K := by
  exact isGalois_iff.mpr ⟨inferInstance, ClassFieldIdealAction.base_normal M hM⟩
attribute [instance] base_isGalois

/-- The normalized values lie in F. [RW26, Thm. 1]; [RW-rec, Prop. 4]. -/
theorem normalized_mem_field (m : ℕ) (x : ActualLattice.Group M hM) :
    U x ∈ field M hM m := by
  exact FiniteGaloisEnvelope.subset_envelope _ _ (normalized_mem_values M hM x)

/-- The same number, viewed in F by membership in the normal envelope. -/
def normalizedInEnvelope (m : ℕ) (x : ActualLattice.Group M hM) : field M hM m :=
  ⟨U x, normalized_mem_field M hM m x⟩

/-- This is the inclusion of the subtype, at the same algebraic number. -/
theorem coe_normalizedInEnvelope (m : ℕ) (x : ActualLattice.Group M hM) :
    (normalizedInEnvelope M hM m x : Galois.Qbar) = U x := by
  rfl

/-- [RW-rec, p. 3, Def. 1]: the origin in F is 1. -/
theorem normalizedInEnvelope_zero (m : ℕ) : normalizedInEnvelope M hM m 0 = 1 := by
  apply Subtype.ext
  exact SplitPrimeValues.normalizedLift_zero P₀ I

/-- Restriction along H ≤ F, using the normal-subfield operation.
No extra reciprocity hypothesis is added. [RW-rec, Prop. 4]. -/
def restrictH (m : ℕ) : (field M hM m ≃ₐ[ℚ] field M hM m) →*
    (ClassFieldTransport.H M hM (RayArithmeticModulus.level M hM m) ≃ₐ[ℚ]
      ClassFieldTransport.H M hM (RayArithmeticModulus.level M hM m)) :=
  FrobeniusRestriction.restrictGalois _ _ (classField_le M hM m)

/-- Restriction along K ≤ F. [RW26, (37)]; [RW-rec, Prop. 4]. -/
def restrictK (m : ℕ) : (field M hM m ≃ₐ[ℚ] field M hM m) →* (K ≃ₐ[ℚ] K) :=
  FrobeniusRestriction.restrictGalois _ _ (base_le M hM m)

/-- Restriction preserves the embeddings into ℚ̄. [RW-rec, Prop. 4]. -/
theorem restrictH_apply (m : ℕ) (g : field M hM m ≃ₐ[ℚ] field M hM m)
    (a : ClassFieldTransport.H M hM (RayArithmeticModulus.level M hM m)) :
    (restrictH M hM m g a : Galois.Qbar) =
      (g (IntermediateField.inclusion (classField_le M hM m) a) : Galois.Qbar) := by
  exact FrobeniusRestriction.restrictGalois_apply _ _ _ g a

/-- This equality is the meaning of fixing K. [RW26, (37)]; [RW-rec, Prop. 4]. -/
theorem restrictK_apply (m : ℕ) (g : field M hM m ≃ₐ[ℚ] field M hM m) (a : K) :
    (restrictK M hM m g a : Galois.Qbar) =
      (g (IntermediateField.inclusion (base_le M hM m) a) : Galois.Qbar) := by
  exact FrobeniusRestriction.restrictGalois_apply _ _ _ g a

end SICLean.L5.DescentField
